# Run scripts/local_setup.py to populate ignored local .env files from Supabase.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://chalkmate_app:REPLACE_LOCALLY@127.0.0.1:54322/postgres
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
WORKER_DATABASE_URL=postgresql+psycopg://chalkmate_worker:REPLACE_LOCALLY@127.0.0.1:54322/postgres
WORKER_CONTAINER_DATABASE_URL=postgresql+psycopg://chalkmate_worker:REPLACE_LOCALLY@host.docker.internal:54322/postgres
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=REPLACE_LOCALLY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_LOCALLY
WEB_ORIGIN=http://localhost:3000
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_VISION_MODEL=gemma3:4b

# Local test messages are captured in Mailpit; no external email is sent.
MAIL_PROVIDER=mailpit
MAILPIT_URL=http://127.0.0.1:54324
MAIL_FROM=Chalkmate <teacher@example.com>
# Optional external transport. Keep disabled for local development.
ENABLE_EXTERNAL_EMAIL=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Last successful local full-stack recovery report shown in Readiness.
RECOVERY_REPORT_PATH=.tmp/recovery-last-report.json
